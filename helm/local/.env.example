# helm/local/.env.example — dev credentials template for the local k3d stack.
#
# Copy this file to helm/local/.env to override the baked-in dev defaults:
#
#   cp helm/local/.env.example helm/local/.env
#
# helm/local/up.sh sources helm/local/.env (if present) and uses these values
# to (a) create the matching Kubernetes Secrets in the cluster and (b) pass
# the credentials into the NATS chart's auth block at install time.
#
# These are DEV-ONLY credentials. They are deliberately weak — the local k3d
# cluster is not reachable from the public internet. Do NOT reuse them for
# anything else. The .env file is gitignored so a per-developer override
# stays local.

# --- NATS basic auth ------------------------------------------------------
# Mirrors the (user, password) pair used by the docker-compose nats-dev
# sandbox at docker/docker-compose.nats-dev.yaml so the same client code
# works against either substrate.
NATS_USER=sfu-cluster
NATS_PASSWORD=testpass123

# --- Postgres -------------------------------------------------------------
# Username/database also referenced by helm/postgres/values-local.yaml.
POSTGRES_USER=rustlemania
POSTGRES_DB=rustlemania
POSTGRES_PASSWORD=local-postgres-dev
